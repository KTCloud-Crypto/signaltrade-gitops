{
  "id": null,
  "uid": "signaltrade-security-operations",
  "title": "SignalTrade 보안 운영",
  "description": "ALB 로그로 Backend 도달 여부를 확인하고 CloudFront 로그로 실제 원천 IP를 분석합니다. 두 계층의 동일 요청을 단순 합산하지 않으며 애플리케이션 보안 지표를 함께 확인합니다.",
  "tags": ["signaltrade", "security", "operations"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]},
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "실행 환경",
        "type": "query",
        "datasource": {"uid": "loki", "type": "loki"},
        "query": {"query": "label_values(environment)", "refId": "LokiVariableQueryEditor-VariableQuery"},
        "includeAll": true,
        "allValue": ".+",
        "current": {"text": "전체", "value": "$__all"},
        "refresh": 1
      },
      {
        "name": "client_ip",
        "label": "클라이언트 IP",
        "type": "textbox",
        "query": ".*",
        "current": {"text": ".*", "value": ".*"}
      },
      {
        "name": "request_id",
        "label": "요청 ID",
        "type": "textbox",
        "query": ".*",
        "current": {"text": ".*", "value": ".*"}
      },
      {
        "name": "suspicious_path",
        "type": "constant",
        "hide": 2,
        "query": "(?i).*(/\\.env($|/)|/\\.git($|/)|/wp-admin($|/)|/wp-login\\.php|/phpinfo\\.php|/actuator($|/)|/server-status|/vendor/phpunit|/config($|/)|/docker-compose|/composer\\.(json|lock)|/package(-lock)?\\.json|\\.(sql|bak|pem|key)($|/)).*",
        "current": {"text": "suspicious path regex", "value": "(?i).*(/\\.env($|/)|/\\.git($|/)|/wp-admin($|/)|/wp-login\\.php|/phpinfo\\.php|/actuator($|/)|/server-status|/vendor/phpunit|/config($|/)|/docker-compose|/composer\\.(json|lock)|/package(-lock)?\\.json|\\.(sql|bak|pem|key)($|/)).*"}
      }
    ]
  },
  "annotations": {"list": []},
  "panels": [
    {
      "type": "stat",
      "title": "Backend 도달 의심 경로 (1시간)",
      "description": "ALB가 최근 1시간 동안 Backend로 전달한 .env, .git, wp-admin, phpinfo 등 취약 파일·관리 경로 탐색 요청입니다.",
      "datasource": {"uid": "loki", "type": "loki"},
      "targets": [{"expr": "sum(count_over_time({service=\"edge-alb\",source=\"alb\",log_type=\"security_access\",environment=~\"$environment\"} | json | event=\"http_request_completed\" | path=~\"${suspicious_path:raw}\" [1h]))", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}}},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto", "wideLayout": true},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5}
    },
    {
      "type": "stat",
      "title": "로그인 실패 (15분)",
      "description": "최근 15분 동안 발생한 비밀번호 오류, 존재하지 않는 사용자, 계정 잠금 등 실패한 로그인 감사 이벤트 수입니다.",
      "datasource": {"uid": "prometheus", "type": "prometheus"},
      "targets": [{"expr": "sum(increase(signaltrade_security_events_total{event_type=\"login_attempt\",outcome=\"failure\"}[15m])) or vector(0)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto", "wideLayout": true},
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5}
    },
    {
      "type": "stat",
      "title": "권한 거부 403 (15분)",
      "description": "최근 15분 동안 인증은 되었지만 권한이 없거나 정책상 거부된 요청입니다. 특정 IP에서 반복되면 권한 탐색을 의심합니다.",
      "datasource": {"uid": "prometheus", "type": "prometheus"},
      "targets": [{"expr": "sum(increase(signaltrade_http_requests_total{status=\"403\"}[15m])) or vector(0)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}}},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto", "wideLayout": true},
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5}
    },
    {
      "type": "stat",
      "title": "Rate Limit 429 (5분)",
      "description": "요청 제한에 걸린 횟수입니다. 공격 차단뿐 아니라 정상 사용자의 과도한 재시도도 포함될 수 있어 원문 로그와 함께 봅니다.",
      "datasource": {"uid": "prometheus", "type": "prometheus"},
      "targets": [{"expr": "sum(increase(signaltrade_http_requests_total{status=\"429\"}[5m])) or vector(0)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}}},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto", "wideLayout": true},
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5}
    },
    {
      "type": "timeseries",
      "title": "인증·권한·제한 응답 추이",
      "description": "401·403·429 응답의 초당 발생률입니다. 같은 시점에 함께 치솟으면 자동화된 인증·권한 탐색일 가능성이 큽니다.",
      "datasource": {"uid": "prometheus", "type": "prometheus"},
      "targets": [{"expr": "sum by (status) (rate(signaltrade_http_requests_total{status=~\"401|403|429\"}[$__rate_interval]))", "legendFormat": "HTTP {{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "reqps", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never", "spanNulls": true}}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "보안 감사 이벤트 추이",
      "description": "로그인, API 키 변경, 비밀번호 변경, 강제청산 등 감사 대상 이벤트를 유형과 성공 여부별로 보여줍니다.",
      "datasource": {"uid": "prometheus", "type": "prometheus"},
      "targets": [{"expr": "sum by (event_type, outcome) (rate(signaltrade_security_events_total[$__rate_interval]))", "legendFormat": "{{event_type}} · {{outcome}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "ops", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true}}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8}
    },
    {
      "type": "bargauge",
      "title": "의심 경로 상위 10개",
      "description": "ALB까지 도달한 요청 중 가장 많이 탐색된 취약 파일·관리 경로입니다. 새 경로가 반복되면 탐지 규칙과 차단 정책 후보에 추가합니다.",
      "datasource": {"uid": "loki", "type": "loki"},
      "targets": [{"expr": "topk(10, sum by (path) (count_over_time({service=\"edge-alb\",source=\"alb\",log_type=\"security_access\",environment=~\"$environment\"} | json | event=\"http_request_completed\" | path=~\"${suspicious_path:raw}\" [$__range])))", "instant": true, "legendFormat": "{{path}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short", "color": {"mode": "continuous-GrYlRd"}}},
      "options": {"displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "valueMode": "color", "namePlacement": "left", "valuePlacement": "right"},
      "gridPos": {"x": 0, "y": 13, "w": 8, "h": 8}
    },
    {
      "type": "bargauge",
      "title": "스캐너 IP 상위 10개",
      "description": "CloudFront에서 관측한 실제 Viewer IP 중 의심 경로 요청이 많은 순서입니다. Backend 도달 여부는 같은 시간대의 ALB 의심 경로 패널과 함께 판단합니다.",
      "datasource": {"uid": "loki", "type": "loki"},
      "targets": [{"expr": "topk(10, sum by (client_ip) (count_over_time({service=\"edge-cloudfront\",source=\"cloudfront\",log_type=\"security_access\",environment=~\"$environment\"} | json | event=\"http_request_completed\" | client_ip!=\"\" | client_ip=~\"$client_ip\" | path=~\"${suspicious_path:raw}\" [$__range])))", "instant": true, "legendFormat": "{{client_ip}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short", "color": {"mode": "continuous-GrYlRd"}}},
      "options": {"displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "valueMode": "color", "namePlacement": "left", "valuePlacement": "right"},
      "gridPos": {"x": 8, "y": 13, "w": 8, "h": 8}
    },
    {
      "type": "bargauge",
      "title": "인증·권한 오류 IP 상위 10개",
      "description": "CloudFront에서 관측한 401 또는 403 응답의 실제 Viewer IP입니다. 로그인 실패뿐 아니라 만료된 인증과 권한 탐색 요청도 포함됩니다.",
      "datasource": {"uid": "loki", "type": "loki"},
      "targets": [{"expr": "topk(10, sum by (client_ip) (count_over_time({service=\"edge-cloudfront\",source=\"cloudfront\",log_type=\"security_access\",environment=~\"$environment\"} | json | status_code=~\"401|403\" | client_ip!=\"\" | client_ip=~\"$client_ip\" [$__range])))", "instant": true, "legendFormat": "{{client_ip}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short", "color": {"mode": "continuous-GrYlRd"}}},
      "options": {"displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "valueMode": "color", "namePlacement": "left", "valuePlacement": "right"},
      "gridPos": {"x": 16, "y": 13, "w": 8, "h": 8}
    },
    {
      "type": "logs",
      "title": "최근 CloudFront 의심 경로 요청",
      "description": "CloudFront에서 관측한 요청 시각, 실제 Viewer IP, 상태 코드, 메서드와 경로입니다. Backend 도달 여부는 ALB 패널과 시간·경로를 함께 확인합니다.",
      "datasource": {"uid": "loki", "type": "loki"},
      "targets": [{"expr": "{service=\"edge-cloudfront\",source=\"cloudfront\",log_type=\"security_access\",environment=~\"$environment\"} | json | event=\"http_request_completed\" | client_ip=~\"$client_ip\" | request_id=~\"$request_id\" | path=~\"${suspicious_path:raw}\" | line_format \"IP={{.client_ip}} status={{.status_code}} {{.method}} {{.path}} request_id={{.request_id}}\"", "queryType": "range", "refId": "A"}],
      "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none"},
      "gridPos": {"x": 0, "y": 21, "w": 12, "h": 10}
    },
    {
      "type": "logs",
      "title": "최근 인증·권한 오류",
      "description": "401·403 응답의 원천 IP, 요청 경로, User-Agent와 요청 ID를 확인합니다.",
      "datasource": {"uid": "loki", "type": "loki"},
      "targets": [{"expr": "{service=\"edge-cloudfront\",source=\"cloudfront\",log_type=\"security_access\",environment=~\"$environment\"} | json | status_code=~\"401|403\" | client_ip=~\"$client_ip\" | request_id=~\"$request_id\" | line_format \"IP={{.client_ip}} status={{.status_code}} {{.method}} {{.path}} user_agent={{.user_agent}} request_id={{.request_id}}\"", "queryType": "range", "refId": "A"}],
      "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none"},
      "gridPos": {"x": 12, "y": 21, "w": 12, "h": 10}
    },
    {
      "type": "logs",
      "title": "최근 HTTP 오류 접근 로그",
      "description": "CloudFront의 4xx·5xx 응답을 시간순으로 보여줍니다. 실제 Viewer IP·경로·상태 코드를 이용해 탐색이나 장애를 구분합니다.",
      "datasource": {"uid": "loki", "type": "loki"},
      "targets": [{"expr": "{service=\"edge-cloudfront\",source=\"cloudfront\",log_type=\"security_access\",environment=~\"$environment\"} | json | status_code=~\"4..|5..\" | client_ip=~\"$client_ip\" | request_id=~\"$request_id\" | line_format \"IP={{.client_ip}} status={{.status_code}} {{.method}} {{.path}} result={{.result_type}} request_id={{.request_id}}\"", "queryType": "range", "refId": "A"}],
      "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none"},
      "gridPos": {"x": 0, "y": 31, "w": 24, "h": 11}
    }
  ]
}

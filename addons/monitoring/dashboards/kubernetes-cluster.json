{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(kube_deployment_spec_replicas{namespace=\"$namespace\"} - kube_deployment_status_replicas_available{namespace=\"$namespace\"})", "refId": "A"}],
      "title": "Unavailable Deployment Replicas",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(kube_pod_container_status_waiting_reason{namespace=\"$namespace\",reason=\"CrashLoopBackOff\"})", "refId": "A"}],
      "title": "CrashLoopBackOff Containers",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "targets": [{"expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h]))", "refId": "A"}],
      "title": "Container Restarts (1h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "targets": [{"expr": "sum(kube_pod_status_phase{namespace=\"$namespace\",phase=~\"Pending|Unknown|Failed\"})", "refId": "A"}],
      "title": "Non-running Pods",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 5},
      "id": 5,
      "description": "EKS Worker Node별 CPU 사용률입니다. 범례는 가용 영역과 EC2 인스턴스 ID로 표시합니다.",
      "targets": [{"expr": "label_replace(label_replace((1 - avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) * on(node) group_left(provider_id) kube_node_info, \"availability_zone\", \"$1\", \"provider_id\", \"aws:///([^/]+)/.*\"), \"ec2_instance\", \"$1\", \"provider_id\", \".*/(i-[a-z0-9]+)$\")", "legendFormat": "Worker {{availability_zone}} · {{ec2_instance}}", "refId": "A"}],
      "title": "Node CPU 사용량 (AZ·EC2별)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 5},
      "id": 6,
      "description": "EKS Worker Node별 메모리 사용률입니다. 범례는 가용 영역과 EC2 인스턴스 ID로 표시합니다.",
      "targets": [{"expr": "label_replace(label_replace((1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * on(node) group_left(provider_id) kube_node_info, \"availability_zone\", \"$1\", \"provider_id\", \"aws:///([^/]+)/.*\"), \"ec2_instance\", \"$1\", \"provider_id\", \".*/(i-[a-z0-9]+)$\")", "legendFormat": "Worker {{availability_zone}} · {{ec2_instance}}", "refId": "A"}],
      "title": "Node 메모리 사용량 (AZ·EC2별)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 5},
      "id": 7,
      "description": "EKS Worker Node의 파일시스템 사용률입니다. 범례는 가용 영역·EC2 인스턴스 ID·마운트 경로로 표시합니다.",
      "targets": [{"expr": "label_replace(label_replace((1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint!~\"/run/credentials/.*\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\",mountpoint!~\"/run/credentials/.*\"})) * on(node) group_left(provider_id) kube_node_info, \"availability_zone\", \"$1\", \"provider_id\", \"aws:///([^/]+)/.*\"), \"ec2_instance\", \"$1\", \"provider_id\", \".*/(i-[a-z0-9]+)$\")", "legendFormat": "Worker {{availability_zone}} · {{ec2_instance}} · {{mountpoint}}", "refId": "A"}],
      "title": "Node 파일시스템 사용량 (AZ·EC2별)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "각 EKS Worker Node에서 현재 Running 상태인 SignalTrade Pod 수입니다. 애플리케이션 Pod가 없는 Worker도 0으로 표시합니다.",
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "unit": "short", "color": {"mode": "continuous-GrYlRd"}}, "overrides": []},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 13},
      "id": 17,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "valueMode": "color", "namePlacement": "left", "valuePlacement": "right"},
      "targets": [{"expr": "label_replace(label_replace((count by (node) (kube_pod_info{namespace=\"$namespace\"} * on(namespace,pod) group_left(phase) (kube_pod_status_phase{namespace=\"$namespace\",phase=\"Running\"} == 1)) * on(node) group_left(provider_id) kube_node_info) or on(node) (0 * kube_node_info), \"availability_zone\", \"$1\", \"provider_id\", \"aws:///([^/]+)/.*\"), \"ec2_instance\", \"$1\", \"provider_id\", \".*/(i-[a-z0-9]+)$\")", "instant": true, "legendFormat": "Worker {{availability_zone}} · {{ec2_instance}}", "refId": "A"}],
      "title": "Worker Node별 실행 중인 Pod 수",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "각 EKS Worker Node에 현재 배치된 Pod를 보여줍니다. Node는 서비스 전용이 아니며 재배포 시 Pod 배치가 달라질 수 있습니다.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 18},
      "id": 14,
      "options": {"showHeader": true},
      "targets": [{"expr": "label_replace(label_replace(kube_pod_info{namespace=\"$namespace\"} * on(node) group_left(provider_id) kube_node_info, \"availability_zone\", \"$1\", \"provider_id\", \"aws:///([^/]+)/.*\"), \"ec2_instance\", \"$1\", \"provider_id\", \".*/(i-[a-z0-9]+)$\")", "format": "table", "instant": true, "refId": "A"}],
      "title": "Worker Node별 실행 Pod 배치",
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true, "__name__": true, "created_by_kind": true, "created_by_name": true, "host_network": true, "instance": true, "job": true, "namespace": true, "provider_id": true, "uid": true}, "indexByName": {"availability_zone": 0, "ec2_instance": 1, "pod": 2, "pod_ip": 3, "host_ip": 4}, "renameByName": {"availability_zone": "AZ", "ec2_instance": "EC2 Worker", "pod": "실행 Pod", "pod_ip": "Pod IP", "host_ip": "Node IP", "node": "Kubernetes Node"}}},
        {"id": "sortBy", "options": {"fields": {}, "sort": [{"field": "AZ"}, {"field": "EC2 Worker"}]}}
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "현재 Kubernetes에 존재하는 Pod의 상태, 실행 시간, 배치 Node와 IP를 표시합니다. 실행 시간은 현재 Pod가 생성된 후 경과한 시간입니다.",
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
      "id": 15,
      "options": {"showHeader": true},
      "targets": [{"expr": "(time() - kube_pod_created{namespace=\"$namespace\"}) * on(namespace,pod) group_left(node,pod_ip,host_ip) kube_pod_info{namespace=\"$namespace\"} * on(namespace,pod) group_left(phase) (kube_pod_status_phase{namespace=\"$namespace\"} == 1)", "format": "table", "instant": true, "refId": "A"}],
      "title": "현재 활성 Pod",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "host_ip": true, "instance": true, "job": true, "namespace": true}, "indexByName": {"pod": 0, "phase": 1, "Value": 2, "node": 3, "pod_ip": 4}, "renameByName": {"pod": "Pod", "phase": "상태", "Value": "실행 시간", "node": "배치 Node", "pod_ip": "Pod IP"}}}],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "선택한 대시보드 시간 범위에는 존재했지만 현재 Kubernetes에서 사라진 Pod입니다. 마지막 관측 이후 경과시간을 보여주며, 원인은 Loki에서 해당 Pod 이름의 과거 로그로 확인할 수 있습니다.",
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
      "id": 16,
      "options": {"showHeader": true},
      "targets": [{"expr": "(time() - max_over_time(timestamp(kube_pod_info{namespace=\"$namespace\"})[$__range:1m])) unless on(namespace,pod) kube_pod_info{namespace=\"$namespace\"}", "format": "table", "instant": true, "refId": "A"}],
      "title": "최근 사라진 Pod",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "host_network": true, "instance": true, "job": true, "namespace": true, "uid": true}, "indexByName": {"pod": 0, "Value": 1, "created_by_kind": 2, "created_by_name": 3, "node": 4, "pod_ip": 5}, "renameByName": {"pod": "사라진 Pod", "Value": "마지막 관측 후 경과", "created_by_kind": "소유 종류", "created_by_name": "소유 리소스", "node": "마지막 배치 Node", "pod_ip": "마지막 Pod IP"}}}],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 34},
      "id": 8,
      "targets": [{"expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container!=\"\",image!=\"\"}[5m]))", "legendFormat": "{{pod}}", "refId": "A"}],
      "title": "Pod CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 34},
      "id": 9,
      "targets": [{"expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\",image!=\"\"})", "legendFormat": "{{pod}}", "refId": "A"}],
      "title": "Pod Memory Working Set",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 42},
      "id": 10,
      "description": "원하는 replica 수보다 실제 사용 가능한 replica 수가 부족한 Deployment만 표시합니다. deployment 열로 장애 서비스를 바로 식별합니다.",
      "options": {"showHeader": true},
      "targets": [{"expr": "kube_deployment_spec_replicas{namespace=\"$namespace\"} - kube_deployment_status_replicas_available{namespace=\"$namespace\"} > 0", "format": "table", "instant": true, "refId": "A"}],
      "title": "Unavailable Deployments (deployment별 부족 replica)",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true}, "renameByName": {"Value": "unavailable replicas"}}}],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 42},
      "id": 11,
      "description": "CrashLoopBackOff, 이미지 다운로드 실패, 컨테이너 설정 오류 상태만 표시합니다. pod·container·reason 열로 오류 대상을 식별합니다.",
      "options": {"showHeader": true},
      "targets": [{"expr": "kube_pod_container_status_waiting_reason{namespace=\"$namespace\",reason=~\"CrashLoopBackOff|ImagePullBackOff|ErrImagePull|CreateContainerConfigError\"} == 1", "format": "table", "instant": true, "refId": "A"}],
      "title": "Waiting/Error Containers (pod·container·reason)",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true, "__name__": true}}}],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 50},
      "id": 12,
      "description": "최근 1시간 재시작이 발생한 컨테이너를 횟수순으로 표시합니다. 일시적으로 복구되어 현재 Running인 장애도 찾을 수 있습니다.",
      "options": {"showHeader": true},
      "targets": [{"expr": "topk(20, increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h])) > 0", "format": "table", "instant": true, "refId": "A"}],
      "title": "Container Restarts by Pod (1h)",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true}, "renameByName": {"Value": "restarts"}}}],
      "type": "table"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 50},
      "id": 13,
      "description": "상단 Pod·Container 필터에서 선택한 대상의 Loki 로그를 최신순으로 표시합니다. 상세 표에서 확인한 이름을 선택해 원인을 추적합니다.",
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"expr": "{namespace=\"$namespace\",pod=~\"$pod\",container=~\"$container\"}", "queryType": "range", "refId": "A"}],
      "title": "Selected Pod/Container Logs",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["signaltrade", "kubernetes"],
  "templating": {
    "list": [
      {
        "current": {"text": "signaltrade-staging", "value": "signaltrade-staging"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(kube_pod_info, namespace)",
        "label": "Namespace",
        "name": "namespace",
        "query": {"query": "label_values(kube_pod_info, namespace)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {"text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
        "includeAll": true,
        "label": "Pod",
        "multi": true,
        "name": "pod",
        "query": {"query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {"text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(kube_pod_container_info{namespace=\"$namespace\",pod=~\"$pod\"}, container)",
        "includeAll": true,
        "label": "Container",
        "multi": true,
        "name": "container",
        "query": {"query": "label_values(kube_pod_container_info{namespace=\"$namespace\",pod=~\"$pod\"}, container)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "SignalTrade Kubernetes 클러스터",
  "uid": "signaltrade-kubernetes",
  "version": 7
}

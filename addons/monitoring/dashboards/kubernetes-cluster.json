{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(kube_deployment_spec_replicas{namespace=\"$namespace\"} - kube_deployment_status_replicas_available{namespace=\"$namespace\"})", "refId": "A"}],
      "title": "Unavailable Deployment Replicas",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(kube_pod_container_status_waiting_reason{namespace=\"$namespace\",reason=\"CrashLoopBackOff\"})", "refId": "A"}],
      "title": "CrashLoopBackOff Containers",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "targets": [{"expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h]))", "refId": "A"}],
      "title": "Container Restarts (1h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "targets": [{"expr": "sum(kube_pod_status_phase{namespace=\"$namespace\",phase=~\"Pending|Unknown|Failed\"})", "refId": "A"}],
      "title": "Non-running Pods",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 5},
      "id": 5,
      "targets": [{"expr": "1 - avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))", "legendFormat": "{{node}}", "refId": "A"}],
      "title": "Node CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 5},
      "id": 6,
      "targets": [{"expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "{{node}}", "refId": "A"}],
      "title": "Node Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 5},
      "id": 7,
      "targets": [{"expr": "1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})", "legendFormat": "{{node}} {{mountpoint}}", "refId": "A"}],
      "title": "Node Filesystem Usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "id": 8,
      "description": "Pod 이름의 배포 해시를 줄여 서비스 역할과 replica 식별자로 표시합니다. api는 요청 처리 Pod, worker는 백그라운드 작업 Pod입니다.",
      "targets": [{"expr": "label_replace(label_replace(sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container!=\"\",image!=\"\"}[5m])), \"workload\", \"$1\", \"pod\", \"^(.*)-[a-z0-9]+-[a-z0-9]+$\"), \"replica\", \"$1\", \"pod\", \"^.*-([a-z0-9]+)$\")", "legendFormat": "{{workload}} · replica {{replica}}", "refId": "A"}],
      "title": "Pod CPU 사용량 (서비스·Replica별)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "id": 9,
      "description": "Pod별 실제 사용 메모리를 서비스 역할과 replica 식별자로 표시합니다. 같은 API의 replica 간 사용량 편차도 비교할 수 있습니다.",
      "targets": [{"expr": "label_replace(label_replace(sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\",image!=\"\"}), \"workload\", \"$1\", \"pod\", \"^(.*)-[a-z0-9]+-[a-z0-9]+$\"), \"replica\", \"$1\", \"pod\", \"^.*-([a-z0-9]+)$\")", "legendFormat": "{{workload}} · replica {{replica}}", "refId": "A"}],
      "title": "Pod 메모리 사용량 (서비스·Replica별)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "id": 10,
      "description": "원하는 replica 수보다 실제 사용 가능한 replica 수가 부족한 Deployment만 표시합니다. deployment 열로 장애 서비스를 바로 식별합니다.",
      "options": {"showHeader": true},
      "targets": [{"expr": "kube_deployment_spec_replicas{namespace=\"$namespace\"} - kube_deployment_status_replicas_available{namespace=\"$namespace\"} > 0", "format": "table", "instant": true, "refId": "A"}],
      "title": "Unavailable Deployments (deployment별 부족 replica)",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true}, "renameByName": {"Value": "unavailable replicas"}}}],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "id": 11,
      "description": "CrashLoopBackOff, 이미지 다운로드 실패, 컨테이너 설정 오류 상태만 표시합니다. pod·container·reason 열로 오류 대상을 식별합니다.",
      "options": {"showHeader": true},
      "targets": [{"expr": "kube_pod_container_status_waiting_reason{namespace=\"$namespace\",reason=~\"CrashLoopBackOff|ImagePullBackOff|ErrImagePull|CreateContainerConfigError\"} == 1", "format": "table", "instant": true, "refId": "A"}],
      "title": "Waiting/Error Containers (pod·container·reason)",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true, "__name__": true}}}],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29},
      "id": 12,
      "description": "최근 1시간 재시작이 발생한 컨테이너를 횟수순으로 표시합니다. 일시적으로 복구되어 현재 Running인 장애도 찾을 수 있습니다.",
      "options": {"showHeader": true},
      "targets": [{"expr": "topk(20, increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h])) > 0", "format": "table", "instant": true, "refId": "A"}],
      "title": "Container Restarts by Pod (1h)",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true}, "renameByName": {"Value": "restarts"}}}],
      "type": "table"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29},
      "id": 13,
      "description": "상단 Pod·Container 필터에서 선택한 대상의 Loki 로그를 최신순으로 표시합니다. 상세 표에서 확인한 이름을 선택해 원인을 추적합니다.",
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"expr": "{namespace=\"$namespace\",pod=~\"$pod\",container=~\"$container\"}", "queryType": "range", "refId": "A"}],
      "title": "Selected Pod/Container Logs",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["signaltrade", "kubernetes"],
  "templating": {
    "list": [
      {
        "current": {"text": "signaltrade-staging", "value": "signaltrade-staging"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(kube_pod_info, namespace)",
        "label": "Namespace",
        "name": "namespace",
        "query": {"query": "label_values(kube_pod_info, namespace)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {"text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
        "includeAll": true,
        "label": "Pod",
        "multi": true,
        "name": "pod",
        "query": {"query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {"text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(kube_pod_container_info{namespace=\"$namespace\",pod=~\"$pod\"}, container)",
        "includeAll": true,
        "label": "Container",
        "multi": true,
        "name": "container",
        "query": {"query": "label_values(kube_pod_container_info{namespace=\"$namespace\",pod=~\"$pod\"}, container)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "SignalTrade Kubernetes 클러스터",
  "uid": "signaltrade-kubernetes",
  "version": 3

{
  "id": null,
  "uid": "signaltrade-load-test",
  "title": "SignalTrade 부하 테스트",
  "description": "k6 입력부터 사용자 체감, MSA 서비스·Deployment·Pod·Worker Node·RDS까지 병목 위치를 단계적으로 추적하는 대시보드입니다.",
  "tags": ["signaltrade", "load-test", "k6", "kubernetes"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "editable": true,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]},
  "templating": {
    "list": [
      {"name": "test_type", "label": "테스트 유형", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": {"query": "label_values(k6_http_reqs_total, test_type)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "includeAll": true, "allValue": ".*", "current": {"text": "전체", "value": "$__all"}, "refresh": 1},
      {"name": "test_run_id", "label": "테스트 실행 ID", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": {"query": "label_values(k6_http_reqs_total{test_type=~\"$test_type\"}, test_run_id)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "includeAll": true, "allValue": ".*", "current": {"text": "전체", "value": "$__all"}, "refresh": 1},
      {"name": "scenario", "label": "k6 시나리오", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": {"query": "label_values(k6_http_reqs_total{test_type=~\"$test_type\",test_run_id=~\"$test_run_id\"}, scenario)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "includeAll": true, "allValue": ".*", "current": {"text": "전체", "value": "$__all"}, "refresh": 1},
      {"name": "service", "label": "API 서비스", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": {"query": "label_values(signaltrade_http_requests_total{job=~\"identity-api|strategy-api|trading-api|portfolio-api\"}, job)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "includeAll": true, "allValue": ".*", "current": {"text": "전체", "value": "$__all"}, "refresh": 1},
      {"name": "route", "label": "API 경로", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": {"query": "label_values(signaltrade_http_requests_total{job=~\"$service\",route!~\"/health|/ready|/metrics\"}, route)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "includeAll": true, "allValue": ".*", "current": {"text": "전체", "value": "$__all"}, "refresh": 1},
      {"name": "pod", "label": "Pod", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": {"query": "label_values(kube_pod_info{namespace=\"signaltrade-staging\",pod=~\"(identity|strategy|trading|portfolio)-api-.*|(strategy|trading|portfolio|notification|messaging)-worker-.*\",pod=~\"($service)-.*\"}, pod)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "includeAll": true, "allValue": ".*", "current": {"text": "전체", "value": "$__all"}, "refresh": 1},
      {"name": "node", "label": "Worker Node", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": {"query": "label_values(kube_node_info, node)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "includeAll": true, "allValue": ".*", "current": {"text": "전체", "value": "$__all"}, "refresh": 1}
    ]
  },
  "annotations": {"list": []},
  "panels": [
    {"type": "row", "title": "1. 부하 입력과 사용자 결과", "collapsed": false, "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "panels": []},
    {"type": "stat", "title": "현재 k6 VU", "description": "선택한 테스트 실행·시나리오의 현재 Virtual User 수입니다. 단계형 읽기 부하에서 10→20→… 증가 구간을 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum(k6_vus{test_type=~\"$test_type\",test_run_id=~\"$test_run_id\",scenario=~\"$scenario\"}) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}}, "gridPos": {"x": 0, "y": 1, "w": 4, "h": 4}},
    {"type": "stat", "title": "k6 전송 RPS", "description": "k6가 선택한 실행·시나리오에서 전송한 초당 요청 수입니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum(rate(k6_http_reqs_total{test_type=~\"$test_type\",test_run_id=~\"$test_run_id\",scenario=~\"$scenario\"}[1m])) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 1}}, "gridPos": {"x": 4, "y": 1, "w": 4, "h": 4}},
    {"type": "stat", "title": "Backend 수신 RPS", "description": "헬스체크를 제외하고 Backend가 실제 수신한 RPS입니다. k6 RPS와 차이가 크면 Backend 도달 전 구간을 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum(rate(signaltrade_http_requests_total{job=~\"$service\",route=~\"$route\",route!~\"/health|/ready|/metrics\"}[1m])) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 1}}, "gridPos": {"x": 8, "y": 1, "w": 4, "h": 4}},
    {"type": "stat", "title": "Backend 5xx 오류율", "description": "Backend에 도달한 실제 요청 중 5xx 비율입니다. 0%가 정상입니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum(rate(signaltrade_http_requests_total{job=~\"$service\",route=~\"$route\",route!~\"/health|/ready|/metrics\",status=~\"5..\"}[1m])) / clamp_min(sum(rate(signaltrade_http_requests_total{job=~\"$service\",route=~\"$route\",route!~\"/health|/ready|/metrics\"}[1m])), 0.001) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}]}}}, "gridPos": {"x": 12, "y": 1, "w": 4, "h": 4}},
    {"type": "stat", "title": "k6 실패율", "description": "k6 관점의 실패율로 연결·타임아웃 등 사용자 관점 실패를 포함합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "avg(k6_http_req_failed{test_type=~\"$test_type\",test_run_id=~\"$test_run_id\",scenario=~\"$scenario\"}) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}]}}}, "gridPos": {"x": 16, "y": 1, "w": 4, "h": 4}},
    {"type": "stat", "title": "Dropped Iterations", "description": "고정 RPS 테스트에서 목표 도착률을 유지하지 못해 시작하지 못한 iteration 수입니다. 0건이 정상입니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum(increase(k6_dropped_iterations_total{test_type=~\"$test_type\",test_run_id=~\"$test_run_id\",scenario=~\"$scenario\"}[$__range])) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}, "gridPos": {"x": 20, "y": 1, "w": 4, "h": 4}},
    {"type": "timeseries", "title": "k6 전송 RPS vs Backend 수신 RPS", "description": "부하 발생기가 보낸 RPS와 애플리케이션이 받은 RPS를 비교합니다. 차이가 지속되면 ALB·네트워크·rate limit을 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum(rate(k6_http_reqs_total{test_type=~\"$test_type\",test_run_id=~\"$test_run_id\",scenario=~\"$scenario\"}[1m]))", "legendFormat": "k6 전송"}, {"expr": "sum(rate(signaltrade_http_requests_total{job=~\"$service\",route=~\"$route\",route!~\"/health|/ready|/metrics\"}[1m]))", "legendFormat": "Backend 수신"}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}, "gridPos": {"x": 0, "y": 5, "w": 12, "h": 7}},
    {"type": "timeseries", "title": "상태 코드별 Backend RPS", "description": "서비스가 반환한 상태 코드별 RPS입니다. 4xx와 5xx 증가 시점을 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum by (status) (rate(signaltrade_http_requests_total{job=~\"$service\",route=~\"$route\",route!~\"/health|/ready|/metrics\"}[1m]))", "legendFormat": "HTTP {{status}}"}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}, "gridPos": {"x": 12, "y": 5, "w": 12, "h": 7}},
    {"type": "row", "title": "2. 응답시간과 서비스 병목", "collapsed": false, "gridPos": {"x": 0, "y": 12, "w": 24, "h": 1}, "panels": []},
    {"type": "timeseries", "title": "k6 사용자 응답시간 p95·p99", "description": "k6가 측정한 요청 전체 구간의 p95·p99입니다. Backend 내부 p95보다 크게 높으면 ALB·네트워크 구간을 확인합니다. k6 실행 시 K6_PROMETHEUS_RW_TREND_STATS=p(95),p(99)를 사용합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "max(k6_http_req_duration_p95{test_type=~\"$test_type\",test_run_id=~\"$test_run_id\",scenario=~\"$scenario\"}) or vector(0)", "legendFormat": "k6 p95"}, {"expr": "max(k6_http_req_duration_p99{test_type=~\"$test_type\",test_run_id=~\"$test_run_id\",scenario=~\"$scenario\"}) or vector(0)", "legendFormat": "k6 p99"}], "fieldConfig": {"defaults": {"unit": "ms", "min": 0}}, "gridPos": {"x": 0, "y": 13, "w": 8, "h": 8}},
    {"type": "timeseries", "title": "서비스·API별 p95 응답시간", "description": "헬스체크를 제외한 Backend 내부 p95입니다. 어느 서비스와 경로부터 느려지는지 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, job, method, route) (rate(signaltrade_http_request_duration_seconds_bucket{job=~\"$service\",route=~\"$route\",route!~\"/health|/ready|/metrics\"}[1m]))) and on (job, method, route) sum by (job, method, route) (increase(signaltrade_http_request_duration_seconds_count{job=~\"$service\",route=~\"$route\",route!~\"/health|/ready|/metrics\"}[1m])) > 0", "legendFormat": "{{job}} · {{method}} {{route}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}}, "gridPos": {"x": 8, "y": 13, "w": 8, "h": 8}},
    {"type": "timeseries", "title": "서비스별 수신 RPS", "description": "각 Backend 서비스가 실제로 받은 RPS입니다. 시나리오가 어느 서비스에 부하를 만드는지 보여줍니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum by (job) (rate(signaltrade_http_requests_total{job=~\"$service\",route=~\"$route\",route!~\"/health|/ready|/metrics\"}[1m]))", "legendFormat": "{{job}}"}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}, "gridPos": {"x": 16, "y": 13, "w": 8, "h": 8}},
    {"type": "timeseries", "title": "Pod별 수신 RPS", "description": "같은 Deployment의 Replica에 요청이 고르게 분산되는지 Pod 단위로 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum by (job, pod) (rate(signaltrade_http_requests_total{job=~\"$service\",pod=~\"$pod\",route=~\"$route\",route!~\"/health|/ready|/metrics\"}[1m]))", "legendFormat": "{{job}} · {{pod}}"}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}, "gridPos": {"x": 0, "y": 21, "w": 12, "h": 8}},
    {"type": "timeseries", "title": "Deployment 가용/기대 Replica", "description": "부하 중 서비스별 가용 Replica가 기대 Replica보다 줄어드는지 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "max by (deployment) (kube_deployment_status_replicas_available{namespace=\"signaltrade-staging\",deployment=~\"$service\"})", "legendFormat": "{{deployment}} · 가용"}, {"expr": "max by (deployment) (kube_deployment_spec_replicas{namespace=\"signaltrade-staging\",deployment=~\"$service\"})", "legendFormat": "{{deployment}} · 기대"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0}}, "gridPos": {"x": 12, "y": 21, "w": 12, "h": 8}},
    {"type": "row", "title": "3. Pod 자원과 장애", "collapsed": false, "gridPos": {"x": 0, "y": 29, "w": 24, "h": 1}, "panels": []},
    {"type": "timeseries", "title": "Pod별 CPU 사용량", "description": "서비스 Pod별 CPU 코어 사용량입니다. Replica 간 편중과 포화 시점을 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"signaltrade-staging\",pod=~\"(identity|strategy|trading|portfolio)-api-.*|(strategy|trading|portfolio|notification|messaging)-worker-.*\",pod=~\"$pod\",container!=\"\",container!=\"POD\",image!=\"\"}[1m]))", "legendFormat": "{{pod}}"}], "fieldConfig": {"defaults": {"unit": "cores", "min": 0}}, "gridPos": {"x": 0, "y": 30, "w": 8, "h": 8}},
    {"type": "timeseries", "title": "Pod별 메모리 사용량", "description": "서비스 Pod별 working set 메모리입니다. 지속 증가와 Replica 간 편중을 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"signaltrade-staging\",pod=~\"(identity|strategy|trading|portfolio)-api-.*|(strategy|trading|portfolio|notification|messaging)-worker-.*\",pod=~\"$pod\",container!=\"\",container!=\"POD\",image!=\"\"})", "legendFormat": "{{pod}}"}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}}, "gridPos": {"x": 8, "y": 30, "w": 8, "h": 8}},
    {"type": "timeseries", "title": "Pod별 CPU Throttling", "description": "CPU 제한 때문에 실행이 지연된 비율입니다. CPU limit 병목을 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"signaltrade-staging\",pod=~\"(identity|strategy|trading|portfolio)-api-.*|(strategy|trading|portfolio|notification|messaging)-worker-.*\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}[1m])) / clamp_min(sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=\"signaltrade-staging\",pod=~\"(identity|strategy|trading|portfolio)-api-.*|(strategy|trading|portfolio|notification|messaging)-worker-.*\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}[1m])), 0.001)", "legendFormat": "{{pod}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}, "gridPos": {"x": 16, "y": 30, "w": 8, "h": 8}},
    {"type": "stat", "title": "Pod 재시작 (테스트 구간)", "description": "선택한 시간 범위에 발생한 애플리케이션 컨테이너 재시작 수입니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"signaltrade-staging\",pod=~\"(identity|strategy|trading|portfolio)-api-.*|(strategy|trading|portfolio|notification|messaging)-worker-.*\",pod=~\"$pod\"}[$__range])) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}, "gridPos": {"x": 0, "y": 38, "w": 6, "h": 4}},
    {"type": "stat", "title": "OOM 발생 (테스트 구간)", "description": "선택한 시간 범위에 발생한 컨테이너 OOM 이벤트 수입니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum(increase(container_oom_events_total{namespace=\"signaltrade-staging\",pod=~\"(identity|strategy|trading|portfolio)-api-.*|(strategy|trading|portfolio|notification|messaging)-worker-.*\",pod=~\"$pod\",container!=\"\"}[$__range])) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}, "gridPos": {"x": 6, "y": 38, "w": 6, "h": 4}},
    {"type": "stat", "title": "가용 Replica 부족", "description": "기대 Replica보다 가용 Replica가 부족한 API Deployment 수입니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum(max by (deployment) (kube_deployment_status_replicas_available{namespace=\"signaltrade-staging\",deployment=~\"$service\"}) < bool max by (deployment) (kube_deployment_spec_replicas{namespace=\"signaltrade-staging\",deployment=~\"$service\"})) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}, "gridPos": {"x": 12, "y": 38, "w": 6, "h": 4}},
    {"type": "stat", "title": "Worker 작업 실패", "description": "테스트 시간 범위에 발생한 Worker 작업 실패 수입니다. API 부하가 비동기 처리에 미친 영향을 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum(increase(signaltrade_worker_task_runs_total{result=\"error\"}[$__range])) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}, "gridPos": {"x": 18, "y": 38, "w": 6, "h": 4}},
    {"type": "row", "title": "4. Worker Node 영향", "collapsed": false, "gridPos": {"x": 0, "y": 42, "w": 24, "h": 1}, "panels": []},
    {"type": "timeseries", "title": "Worker Node별 CPU 사용률", "description": "Worker Node 전체 CPU 사용률입니다. Pod 병목인지 Node 전체 포화인지 구분합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "label_replace(label_replace((1 - avg by (node) (rate(node_cpu_seconds_total{node=~\"$node\",mode=\"idle\"}[1m]))) * on (node) group_left(provider_id) kube_node_info{node=~\"$node\"}, \"availability_zone\", \"$1\", \"provider_id\", \"aws:///([^/]+)/.*\"), \"ec2_instance\", \"$1\", \"provider_id\", \".*/(i-[a-z0-9]+)$\")", "legendFormat": "Worker {{availability_zone}} · {{ec2_instance}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}, "gridPos": {"x": 0, "y": 43, "w": 8, "h": 8}},
    {"type": "timeseries", "title": "Worker Node별 메모리 사용률", "description": "Worker Node별 메모리 사용률입니다. Node 단위 memory pressure 가능성을 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "label_replace(label_replace((1 - (node_memory_MemAvailable_bytes{node=~\"$node\"} / node_memory_MemTotal_bytes{node=~\"$node\"})) * on (node) group_left(provider_id) kube_node_info{node=~\"$node\"}, \"availability_zone\", \"$1\", \"provider_id\", \"aws:///([^/]+)/.*\"), \"ec2_instance\", \"$1\", \"provider_id\", \".*/(i-[a-z0-9]+)$\")", "legendFormat": "Worker {{availability_zone}} · {{ec2_instance}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}, "gridPos": {"x": 8, "y": 43, "w": 8, "h": 8}},
    {"type": "timeseries", "title": "Worker Node별 실행 Pod 수", "description": "각 Worker Node에 Running 상태로 배치된 Pod 수입니다. 부하 대상 Pod가 어느 Node에 몰렸는지 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "label_replace(label_replace(sum by (node) (kube_pod_info{namespace=\"signaltrade-staging\",node=~\"$node\"} * on (namespace, pod) group_left() (kube_pod_status_phase{namespace=\"signaltrade-staging\",phase=\"Running\"} == 1)) * on (node) group_left(provider_id) kube_node_info{node=~\"$node\"}, \"availability_zone\", \"$1\", \"provider_id\", \"aws:///([^/]+)/.*\"), \"ec2_instance\", \"$1\", \"provider_id\", \".*/(i-[a-z0-9]+)$\")", "legendFormat": "Worker {{availability_zone}} · {{ec2_instance}}"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0}}, "gridPos": {"x": 16, "y": 43, "w": 8, "h": 8}},
    {"type": "row", "title": "5. RDS 영향", "collapsed": false, "gridPos": {"x": 0, "y": 51, "w": 24, "h": 1}, "panels": []},

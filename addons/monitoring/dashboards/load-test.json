    {"type": "timeseries", "title": "서비스·작업별 Upbit p95", "description": "각 서비스 Pod에서 Upbit 요청을 보내 응답을 받을 때까지의 p95입니다. API p95와 함께 상승하면 외부 호출 구간 병목을 의심합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by(le,job,operation) (rate(signaltrade_external_request_duration_seconds_bucket{provider=\"upbit\",job=~\"$service\"}[1m])))", "legendFormat": "{{job}} · {{operation}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0, "noValue": "데이터 없음"}}, "gridPos": {"x": 0, "y": 105, "w": 8, "h": 8}, "id": 51},
    {"type": "timeseries", "title": "서비스·작업·결과별 Upbit RPS", "description": "Upbit 호출 처리량과 success·error·timeout·HTTP 상태 결과를 서비스별로 비교합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum by(job,operation,outcome) (rate(signaltrade_external_requests_total{provider=\"upbit\",job=~\"$service\"}[1m]))", "legendFormat": "{{job}} · {{operation}} · {{outcome}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "noValue": "데이터 없음"}}, "gridPos": {"x": 8, "y": 105, "w": 8, "h": 8}, "id": 52},
    {"type": "timeseries", "title": "Upbit 외부 호출 오류율", "description": "전체 Upbit 호출 중 success가 아닌 결과의 비율입니다. http_429는 요청 제한, http_5xx는 Upbit 응답 오류, timeout·connection_error는 외부 통신 구간을 우선 확인합니다.", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"expr": "sum by(job) (rate(signaltrade_external_requests_total{provider=\"upbit\",job=~\"$service\",outcome!=\"success\"}[1m])) / clamp_min(sum by(job) (rate(signaltrade_external_requests_total{provider=\"upbit\",job=~\"$service\"}[1m])), 0.001)", "legendFormat": "{{job}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "noValue": "데이터 없음"}}, "gridPos": {"x": 16, "y": 105, "w": 8, "h": 8}, "id": 53},
